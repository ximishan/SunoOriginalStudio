{
  "name": "suno-original-demo",
  "version": "0.3.0",
  "description": "Suno original-song desktop tool with official verification handoff and integrated N19 audio trace cleaner",
  "main": "bootstrap.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "37.4.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.musicvmauto.sunooriginaldemo",
    "productName": "Suno原创Demo",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "bootstrap.js",
      "main.js",
      "deai.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "package.json",
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [{"target": "portable", "arch": ["x64"]}],
      "artifactName": "SunoOriginalStudio_v0.3.0.exe"
    }
  }
}
