{
  "name": "suno-original-demo",
  "version": "0.5.19",
  "description": "Suno Original Studio with the verified reference EXE download chain: official WAV, official MP3, playback media sniffing, WASAPI loopback capture, requests streaming, and exact AVR N19 processing.",
  "main": "bootstrap.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "electron": "37.4.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.musicvmauto.sunooriginaldemo",
    "productName": "Suno原创Demo",
    "asar": true,
    "files": [
      "bootstrap.js",
      "main.js",
      "suno_session.js",
      "auth_fetch_guard.js",
      "reference_runtime.js",
      "reference_download_compat.js",
      "suno_transport_compat.js",
      "mature_media_fetch.js",
      "deai.js",
      "song_library.js",
      "song_library_guard.js",
      "song_refresh_fix.js",
      "suno_library_sync.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "account_slots_fix.js",
      "batch_renderer.js",
      "suno_sync_renderer.js",
      "node_modules/xlsx/**/*",
      "package.json"
    ],
    "extraResources": [
      {"from":"vendor/avr-n19","to":"tools/n19","filter":["**/*"]},
      {"from":"vendor/reference-python","to":"tools/reference-python","filter":["**/*"]},
      {"from":"reference_capture_helper.py","to":"tools/reference-download/reference_capture_helper.py"}
    ],
    "win": {
      "target": [{"target":"portable","arch":["x64"]}],
      "artifactName": "SunoOriginalStudio_v${version}.exe"
    }
  }
}
