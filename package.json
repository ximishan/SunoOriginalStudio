{
  "name": "suno-original-demo",
  "version": "0.5.7",
  "description": "Suno original-song desktop tool with unified Clerk auth, background polling, automatic WAV and lyrics saving, optional exact AVR N19 processing, and a persistent song library",
  "main": "bootstrap.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "37.4.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.musicvmauto.sunooriginaldemo",
    "productName": "Suno原创Demo",
    "asar": true,
    "files": [
      "bootstrap.js",
      "main.js",
      "suno_session.js",
      "deai.js",
      "song_library.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "account_slots_fix.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/avr-n19",
        "to": "tools/n19",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [{"target":"portable","arch":["x64"]}],
      "artifactName": "SunoOriginalStudio_v0.5.7.exe"
    }
  }
}
