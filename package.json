{
  "name": "suno-original-demo",
  "version": "0.4.0",
  "description": "Suno original-song desktop tool with official verification handoff and exact AVR N19 SoX/Rubber Band/FFmpeg audio chain",
  "main": "bootstrap.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "37.4.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.musicvmauto.sunooriginaldemo",
    "productName": "Suno原创Demo",
    "asar": true,
    "files": [
      "bootstrap.js",
      "main.js",
      "deai.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/avr-n19",
        "to": "tools/n19",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [{"target": "portable", "arch": ["x64"]}],
      "artifactName": "SunoOriginalStudio_v0.4.0.exe"
    }
  }
}
