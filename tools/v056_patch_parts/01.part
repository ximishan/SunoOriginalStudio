from pathlib import Path
import json
import re

changed = set()

def read(file):
    return Path(file).read_text(encoding='utf-8').replace('\r\n', '\n')

def write(file, text):
    Path(file).write_text(text, encoding='utf-8', newline='\n')
    changed.add(file)

def patch_literal(file, old, new, label, marker=None):
    text = read(file)
    if marker and marker in text:
        return False
    if new in text:
        return False
    if old not in text:
        raise RuntimeError(f'{file}: cannot find expected source for {label}')
    write(file, text.replace(old, new, 1))
    return True

def patch_regex(file, pattern, new, label, marker=None, flags=0):
    text = read(file)
    if marker and marker in text:
        return False
    rx = re.compile(pattern, flags)
    if not rx.search(text):
        raise RuntimeError(f'{file}: cannot find expected source for {label}')
    write(file, rx.sub(lambda _m: new, text, count=1))
    return True

